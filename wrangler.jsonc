// Cloudflare Workers config. Cloudflare deploys this automatically
// on every push to main once the repo is connected (see README).
{
  "name": "gym-fines",
  "main": "worker/app.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  // Supabase keep-alive (worker/app.js "scheduled"): 09:00 UTC every 2 days.
  "triggers": {
    "crons": ["0 9 */2 * *"]
  }
}
